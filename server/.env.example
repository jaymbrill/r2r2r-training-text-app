PORT=3001

# Base URL of this server, used for OAuth callbacks (must be reachable by the browser)
APP_BASE_URL=http://localhost:3001
# Where to send the browser back after OAuth
CLIENT_URL=http://localhost:5173

# Strava API application (create at https://www.strava.com/settings/api)
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Anthropic API key for plan generation (https://platform.claude.com).
# Without it, a placeholder plan generator is used (marked model "fallback").
ANTHROPIC_API_KEY=

# Twilio for SMS (https://console.twilio.com). Without credentials, outgoing
# texts are logged to the console instead of sent.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Set to "true" to disable the nightly-text scheduler (e.g. in tests)
DISABLE_SCHEDULER=
